
import sqlite3
import os

def crear_bd():
    os.makedirs("database", exist_ok=True)

    conexion = sqlite3.connect("database/EMPLEADOS.db")
    cursor = conexion.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS empleado (
            CURP TEXT PRIMARY KEY,
            nombre TEXT NOT NULL,
            apellido TEXT NOT NULL,
            calle TEXT NOT NULL,
            colonia TEXT NOT NULL,
            telefono TEXT NOT NULL
        )
    """)

    conexion.commit()
    conexion.close()

    print("\nBase de datos EMPLEADOS creada correctamente.")

def alta_empleado():
    conexion = sqlite3.connect("database/EMPLEADOS.db")
    cursor = conexion.cursor()

    print("\n===== ALTA DE EMPLEADO =====")

    curp = input("CURP: ").strip().upper()
    nombre = input("Nombre: ").strip()
    apellido = input("Apellido: ").strip()
    calle = input("Calle: ").strip()
    colonia = input("Colonia: ").strip()
    telefono = input("Telefono: ").strip()

    if not all([curp, nombre, apellido, calle, colonia, telefono]):
        print("\nError: todos los campos son obligatorios.")
        conexion.close()
        return

    try:
        cursor.execute("""
            INSERT INTO empleado
            (CURP, nombre, apellido, calle, colonia, telefono)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (curp, nombre, apellido, calle, colonia, telefono))

        conexion.commit()
        print("\nEmpleado registrado correctamente.")

    except sqlite3.IntegrityError:
        print("\nError: la CURP ya se encuentra registrada.")

    except sqlite3.Error as error:
        print(f"\nError al registrar al empleado: {error}")

    finally:
        conexion.close()

if __name__ == "__main__":
    crear_bd()

    while True:
        print("\n===== SISTEMA DE EMPLEADOS ACME =====")
        print("1. Crear base de datos")
        print("2. Dar de alta un empleado")
        print("3. Salir")

        opcion = input("Selecciona una opcion: ").strip()

        if opcion == "1":
            crear_bd()

        elif opcion == "2":
            alta_empleado()

        elif opcion == "3":
            print("\nGracias por utilizar el sistema.")
            break

        else:
            print("\nOpcion no valida. Intenta nuevamente.")
